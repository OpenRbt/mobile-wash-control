# Copy to android/key.properties and point storeFile at the release keystore.
# Both files stay out of git: the release build falls back to the debug key
# when key.properties is missing, and a debug key is regenerated on every
# machine, which is what breaks reinstalls over an existing release build.
storePassword=
keyPassword=
keyAlias=upload
storeFile=upload-keystore.jks
